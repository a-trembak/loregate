#!/usr/bin/env bash
# Loregate (lgt) CLI — install / update this workflow kit into Cursor + a project.
# Short mark: LGT. Tagline: From lore to merge through gates.
#
# One-time:
#   git clone <this-repo> ~/loregate
#   ~/loregate/bin/lgt install /path/to/your-app
#
# Later:
#   lgt update /path/to/your-app     # git pull kit + re-sync links & project files

set -euo pipefail

CLI_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
KIT_ROOT="$(cd "$CLI_DIR/.." && pwd)"
INSTALLER="$KIT_ROOT/scripts/install-to-project.sh"

usage() {
  cat <<'EOF'
lgt / Loregate — personal workflow kit (short mark LGT)

Usage:
  lgt install [project-path] [flags]
  lgt update  [project-path] [flags]
  lgt status
  lgt help

Commands:
  install   First-time (or add) sync into ~/.cursor + project
  update    git pull this kit, then re-sync ~/.cursor (+ project if resolved)
  status    Show kit path, commit, and what is linked
  help      Show this help

With no project-path: uses the current git repo, or the multi-repo workspace
you are standing in (cwd with multi-repo.json / graphify-out / 2+ sibling repos).
`lgt update` with no resolvable project refreshes ~/.cursor only.

Flags (install / update):
  --user-only     Only ~/.cursor (no project files); still copies plain-language-chat and code-via-coding-agents rules
  --humanizer     Also install english-humanizer
  --copy          Copy instead of symlink into ~/.cursor
  --agree-policy, --i-agree
                  Accept Privacy, Terms, Disclaimer, NOTICE (docs/legal/).
                  Required for non-interactive install/update. Same as LGT_AGREE_POLICY=1 (alias CSP_AGREE_POLICY=1).
                  Interactive prompt when omitted and stdin is a terminal.
  --language <code>, --lang <code>
                  Set pipeline chat language (.cursor/lgt-pipeline-language; also writes legacy csp marker).
                  Same as LGT_PIPELINE_LANGUAGE (alias CSP_PIPELINE_LANGUAGE). Omit to leave unset (default en;
                  /lgt-start-task asks when unset). Russian (ru) is rejected.
  --skip-third-party-skills
                  Do not run npx skills add for mapped third-party skills
                  (air-gapped). Same as LGT_SKIP_THIRD_PARTY_SKILLS=1 (alias CSP_SKIP_THIRD_PARTY_SKILLS=1)
  -h, --help      Show help

Examples:
  cd ~/code/my-app && lgt install --agree-policy
  cd ~/code/workspace && lgt update --agree-policy   # multi-repo parent or any leaf repo
  lgt install ~/code/my-app --agree-policy --humanizer
  lgt install ~/code/my-app --agree-policy --language uk
  lgt install --user-only --agree-policy --lang de
  lgt install --user-only --agree-policy
  lgt status

Slash commands after install: /lgt-start-task  /lgt-approve-plan  /lgt-start-build  /lgt-finish-plan  /lgt-pr-review  /lgt-engineer-review
Deprecated aliases: /csp-* still install as stubs that forward to /lgt-*.

Do NOT clone this kit into each app. Keep one checkout; install/update per project.
EOF
}

ensure_installer() {
  if [[ ! -f "$INSTALLER" ]]; then
    echo "Installer missing: $INSTALLER" >&2
    exit 1
  fi
  chmod +x "$INSTALLER" 2>/dev/null || true
}

print_status() {
  echo "kit: $KIT_ROOT"
  if git -C "$KIT_ROOT" rev-parse --short HEAD >/dev/null 2>&1; then
    echo "commit: $(git -C "$KIT_ROOT" rev-parse --short HEAD) ($(git -C "$KIT_ROOT" branch --show-current 2>/dev/null || echo detached))"
    echo "remote: $(git -C "$KIT_ROOT" rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null || echo none)"
  fi
  if [[ -f "$HOME/.cursor/cursor-spells-kit-path" ]]; then
    echo "recorded kit path: $(cat "$HOME/.cursor/cursor-spells-kit-path")"
  fi
  echo
  echo "~/.cursor skills (cursor-spells):"
  local p
  for p in "$HOME/.cursor/skills"/*; do
    [[ -e "$p" || -L "$p" ]] || continue
    if [[ -L "$p" ]]; then
      echo "  $(basename "$p") -> $(readlink "$p")"
    else
      echo "  $(basename "$p") (not a symlink)"
    fi
  done 2>/dev/null || echo "  (none)"
  echo
  echo "~/.cursor commands:"
  ls -1 "$HOME/.cursor/commands" 2>/dev/null | sed 's/^/  /' || echo "  (none)"
  echo
  echo "~/.cursor agents:"
  ls -1 "$HOME/.cursor/agents" 2>/dev/null | sed 's/^/  /' || echo "  (none)"
}

cmd="${1:-}"
if [[ -z "$cmd" || "$cmd" == "-h" || "$cmd" == "--help" || "$cmd" == "help" ]]; then
  usage
  exit 0
fi

case "$cmd" in
  install)
    shift
    ensure_installer
    exec "$INSTALLER" "$@"
    ;;
  update)
    shift
    ensure_installer
    echo "Updating kit at $KIT_ROOT …"
    if git -C "$KIT_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      # Prefer pulling the current branch; fall back quietly if no upstream
      if git -C "$KIT_ROOT" rev-parse --abbrev-ref --symbolic-full-name @{u} >/dev/null 2>&1; then
        git -C "$KIT_ROOT" pull --ff-only
      else
        echo "skip git pull (no upstream); syncing local kit as-is"
      fi
    else
      echo "warning: kit is not a git checkout; syncing files only" >&2
    fi
    exec "$INSTALLER" --update "$@"
    ;;
  status)
    print_status
    ;;
  version|--version)
    print_status
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage >&2
    exit 1
    ;;
esac
