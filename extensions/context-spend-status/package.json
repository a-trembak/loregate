{
  "name": "loregate-context-spend-status",
  "displayName": "Loregate Pipeline Status",
  "description": "Pipeline map Webview and context-spend status for Loregate",
  "version": "0.3.2",
  "publisher": "loregate",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "loregate.contextSpend.show",
        "title": "Loregate: Show Context Spend"
      },
      {
        "command": "loregate.pipelineMap.show",
        "title": "Loregate: Show Pipeline Map",
        "icon": "$(map)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "loregate",
          "title": "Loregate",
          "icon": "media/loregate.svg"
        }
      ]
    },
    "views": {
      "loregate": [
        {
          "type": "webview",
          "id": "loregate.pipelineMap",
          "name": "Pipeline Map"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "test": "npm run compile && node --test out/**/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
